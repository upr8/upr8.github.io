{
  "name": "personal-web-site",
  "version": "2.0.0",
  "private": false,
  "description": "A personal website built with Astro.",
  "author": "Saeed Asaiyan",
  "packageManager": "pnpm@11.17.0",
  "keywords": [
    "astro",
    "blog",
    "personal-website"
  ],
  "scripts": {
    "clean": "rm -rf .astro dist",
    "diagrams": "for f in $(find data -name '*.d2'); do d2 \"$f\" \"$f.svg\" --theme 0; done",
    "dev": "pnpm run diagrams && astro dev",
    "start": "astro dev",
    "build": "pnpm run diagrams && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "gh-pages-action": "gh-pages -d dist -b release --dotfiles --remove '**/*'",
    "deploy-action": "pnpm run build && pnpm run gh-pages-action",
    "deploy": "pnpm run build && gh-pages -d dist -b release --dotfiles --remove '**/*'",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:prod": "PLAYWRIGHT_BASE_URL=https://www.asaiyan.com playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "playwright:install": "playwright install chromium",
    "typecheck": "astro check && tsc --noEmit",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "biome:check": "biome check .",
    "biome:check:apply": "biome check . --write",
    "biome:check:apply:unsafe": "biome check . --apply-unsafe",
    "biome:format": "biome format . --write",
    "fix": "pnpm run biome:format && pnpm run biome:check:apply",
    "fix:unsafe": "pnpm run biome:format && pnpm run typecheck && pnpm run biome:check:apply:unsafe"
  },
  "license": "MIT",
  "dependencies": {
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@shikijs/transformers": "^4.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^6.4.8",
    "d3": "^7.9.0",
    "d3-cloud": "^1.2.9",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.0"
  },
  "overrides": {
    "@vite-pwa/astro": {
      "astro": "$astro"
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "^1.62.0",
    "@types/d3": "^7.4.3",
    "@types/d3-cloud": "^1.2.9",
    "@types/node": "^24.13.3",
    "@vite-pwa/astro": "^1.2.0",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
