{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"assist": { "actions": { "source": { "organizeImports": "off" } } },
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/.devcontainer",
			"!**/.vscode",
			"!**/tsconfig.json",
			"!**/package.json",
			"!**/package-lock.json",
			"!**/*.md",
			"!**/LICENSE"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"performance": {
				"noAccumulatingSpread": "off"
			}
		}
	}
}
